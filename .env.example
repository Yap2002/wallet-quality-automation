APP_ENV=local
APP_NAME=wallet-quality-service
DATABASE_URL=mysql+pymysql://wallet:wallet@localhost:53306/wallet?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://wallet:wallet@localhost:53306/wallet_test?charset=utf8mb4
TEST_ENV=test
# Leave empty to let Pytest start a temporary local Uvicorn server.
TEST_BASE_URL=
TEST_REQUEST_TIMEOUT_SECONDS=5
TEST_STARTUP_TIMEOUT_SECONDS=10
CHANNEL_CALLBACK_TOKEN=replace-with-a-secret-outside-git
# Optional. MySQL remains fully functional when this is empty.
REDIS_URL=redis://localhost:6379/0
